{
  "manifest_version": 3,
  "name": "Smoke of Deceit",
  "version": "0.1.0",
  "description": "Remove likes, reactions and comment boxes from social media.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "smoke-of-deceit@lightbeam.ai"
    }
  },
  "permissions": ["storage"],
  "action": {
    "default_title": "Smoke of Deceit",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "src/popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://*.facebook.com/*"],
      "js": [
        "src/shared/settings.js",
        "src/content/observer.js",
        "src/sites/facebook/selectors.js",
        "src/sites/facebook/index.js",
        "src/content/main.js"
      ],
      "run_at": "document_start"
    }
  ]
}
